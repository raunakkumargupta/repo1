<svg xmlns="http://www.w3.org/2000/svg" width="800" height="400" viewBox="0 0 800 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e293b;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#6366f1;stop-opacity:0.1" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="800" height="400" fill="url(#bg)" />
  <!-- Glow blob -->
  <ellipse cx="400" cy="200" rx="300" ry="180" fill="url(#glow)" />
  <!-- Grid lines -->
  <g stroke="rgba(255,255,255,0.04)" stroke-width="1">
    <line x1="0" y1="80" x2="800" y2="80"/>
    <line x1="0" y1="160" x2="800" y2="160"/>
    <line x1="0" y1="240" x2="800" y2="240"/>
    <line x1="0" y1="320" x2="800" y2="320"/>
    <line x1="160" y1="0" x2="160" y2="400"/>
    <line x1="320" y1="0" x2="320" y2="400"/>
    <line x1="480" y1="0" x2="480" y2="400"/>
    <line x1="640" y1="0" x2="640" y2="400"/>
  </g>
  <!-- M icon -->
  <text x="400" y="185" font-family="monospace" font-size="72" font-weight="900" fill="#3b82f6" opacity="0.15" text-anchor="middle" letter-spacing="-4">MATRIX</text>
  <!-- Icon -->
  <rect x="360" y="140" width="80" height="80" rx="18" fill="rgba(59,130,246,0.1)" stroke="rgba(59,130,246,0.3)" stroke-width="1.5"/>
  <text x="400" y="196" font-family="monospace" font-size="36" font-weight="900" fill="#60a5fa" text-anchor="middle">M</text>
  <!-- Label -->
  <text x="400" y="255" font-family="system-ui, sans-serif" font-size="14" fill="rgba(148,163,184,0.7)" text-anchor="middle" font-weight="500">Hackathon Cover Image</text>
</svg>
