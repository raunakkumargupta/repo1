# ==========================================
# BACKEND SERVICES CONFIGURATION
# ==========================================
PORT=8080
JWT_SECRET=super_secret_jwt_key

# PostgreSQL Connection settings
# Note: Use "postgres" as host when running in Docker Compose, and "localhost" if running locally on host.
DB_URL=postgres://postgres:postgres@postgres:5432/hackathon?sslmode=disable
DB_MAX_CONNS=100
DB_MIN_CONNS=10

# Redis Cache settings
# Note: Use "redis" as host when running in Docker Compose, and "localhost" if running locally on host.
REDIS_URL=redis://redis:6379/0

# Allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background Worker Settings
WORKER_POOL_SIZE=50

# Firebase Admin SDK — Push Notifications (FCM V1)
# Place your Firebase service account JSON in the repo root and mount it via docker-compose.yml
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
# Note: Add firebase-service-account.json to .gitignore — never commit it!

# ==========================================
# FRONTEND APP CONFIGURATION
# ==========================================
# Server-side API endpoint for Next.js rewrites
BACKEND_API_URL=http://backend:8080

# Client-side API root path
NEXT_PUBLIC_API_URL=/api

# ==========================================
# COMETCHAT CONFIGURATION
# ==========================================
# CometChat App Credentials (get from https://app.cometchat.com)
# Backend-only (REST API calls for user/group sync)
COMETCHAT_APP_ID=your_app_id_here
COMETCHAT_REGION=in
COMETCHAT_API_KEY=your_rest_api_key_here
COMETCHAT_AUTH_KEY=your_auth_key_here

# Frontend CometChat (client-safe, NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_COMETCHAT_APP_ID=your_app_id_here
NEXT_PUBLIC_COMETCHAT_REGION=in
NEXT_PUBLIC_COMETCHAT_AUTH_KEY=your_auth_key_here
