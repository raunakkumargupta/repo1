<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ── HERO HEADER ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="56dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="36dp"
                        app:cardBackgroundColor="@color/primaryAccent"
                        app:cardElevation="6dp">
                        <TextView
                            android:id="@+id/tv_avatar_big"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="?"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/onPrimary"/>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:id="@+id/tv_profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"/>

                        <TextView
                            android:id="@+id/tv_profile_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/textSecondary"
                            android:layout_marginTop="2dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_profile_role"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_badge"
                                android:textSize="11sp"
                                android:textColor="@color/primaryAccent"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tv_profile_city"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/textSecondary"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="✏️  Edit Profile"
                    android:textAllCaps="false"
                    android:textColor="@color/primaryAccent"
                    app:strokeColor="@color/primaryAccent"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <!-- ── CONTENT ──────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp">

                <!-- BIO -->
                <TextView
                    style="@style/SectionLabel"
                    android:text="BIO"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:id="@+id/tv_profile_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No bio added yet"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:padding="16dp"
                        android:lineSpacingExtra="4dp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- PORTFOLIO & LINKS -->
                <TextView
                    style="@style/SectionLabel"
                    android:text="PORTFOLIO &amp; LINKS"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <LinearLayout
                            android:id="@+id/row_github"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                                android:text="⌨" android:textSize="18sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="GitHub"
                                android:textSize="13sp" android:textColor="@color/textSecondary"
                                android:paddingStart="10dp"/>
                            <TextView android:id="@+id/tv_profile_github"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp"
                                android:textColor="@color/textPrimary"
                                android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/surfaceVariant" android:layout_marginStart="14dp"/>

                        <LinearLayout
                            android:id="@+id/row_linkedin"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                                android:text="💼" android:textSize="18sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="LinkedIn"
                                android:textSize="13sp" android:textColor="@color/textSecondary"
                                android:paddingStart="10dp"/>
                            <TextView android:id="@+id/tv_profile_linkedin"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp"
                                android:textColor="@color/textPrimary"
                                android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/surfaceVariant" android:layout_marginStart="14dp"/>

                        <LinearLayout
                            android:id="@+id/row_resume"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                                android:text="📄" android:textSize="18sp" android:gravity="center"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Resume"
                                android:textSize="13sp" android:textColor="@color/textSecondary"
                                android:paddingStart="10dp"/>
                            <TextView android:id="@+id/tv_profile_resume"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp"
                                android:textColor="@color/textPrimary"
                                android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SKILLS -->
                <TextView style="@style/SectionLabel" android:text="SKILLS"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:id="@+id/tv_profile_skills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No skills added yet"
                        android:textSize="14sp"
                        android:textColor="@color/accentSecondary"
                        android:padding="16dp"
                        android:lineSpacingExtra="4dp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- BASIC DETAILS -->
                <TextView style="@style/SectionLabel" android:text="BASIC DETAILS"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="4dp">
                        <!-- Gender -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Gender"
                                android:textSize="13sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_profile_gender"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp" android:textColor="@color/textPrimary"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/surfaceVariant" android:layout_marginStart="14dp"/>
                        <!-- T-shirt -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="T-Shirt Size"
                                android:textSize="13sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_profile_tshirt"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp" android:textColor="@color/textPrimary"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/surfaceVariant" android:layout_marginStart="14dp"/>
                        <!-- Phone -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Phone"
                                android:textSize="13sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_profile_phone"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp" android:textColor="@color/textPrimary"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- EMERGENCY CONTACT -->
                <TextView style="@style/SectionLabel" android:text="EMERGENCY CONTACT"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Contact Name"
                                android:textSize="13sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_profile_emergency_name"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp" android:textColor="@color/textPrimary"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/surfaceVariant" android:layout_marginStart="14dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Contact Phone"
                                android:textSize="13sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_profile_emergency_number"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp" android:textColor="@color/textPrimary"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- EDUCATION -->
                <TextView style="@style/SectionLabel" android:text="EDUCATION"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:id="@+id/tv_profile_education"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No education info"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:padding="16dp"
                        android:lineSpacingExtra="6dp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- DIETARY -->
                <TextView style="@style/SectionLabel" android:text="DIETARY PREFERENCES"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Preference"
                                android:textSize="13sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_profile_dietary_preference"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp" android:textColor="@color/textPrimary"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/surfaceVariant" android:layout_marginStart="14dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:paddingStart="14dp" android:paddingEnd="14dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Allergies"
                                android:textSize="13sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_profile_allergies"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textSize="13sp" android:textColor="@color/textPrimary"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── SIGN OUT ─────────────────────────────── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sign_out"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Sign Out"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="#FFEF4444"
                    app:strokeColor="#FFEF4444"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/textSecondary"
        app:itemTextColor="@color/textSecondary"
        app:menu="@menu/bottom_nav_menu"/>

</LinearLayout>

    <!-- AI CHATBOT FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_ai_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_ai_bot"
        android:contentDescription="AI Assistant"
        app:backgroundTint="@color/primaryAccent"
        app:tint="@color/onPrimary"
        app:fabSize="normal"
        app:elevation="8dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
