<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- HEADER CARD (avatar + name) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="56dp"
                    android:paddingBottom="24dp">

                    <!-- Big Avatar -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="36dp"
                        app:cardBackgroundColor="@color/primaryAccent"
                        app:cardElevation="4dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tv_avatar_big"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="?"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/onPrimary"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading…"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"/>

                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="2dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_profile_role"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1A0EA5E9"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="12sp"
                            android:textColor="@color/primaryAccent"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_profile_city"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:textColor="@color/textSecondary"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Edit"
                            android:textSize="12sp"
                            app:cornerRadius="8dp"
                            android:padding="0dp"
                            app:iconPadding="0dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- BASIC DETAILS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BASIC DETAILS"
                    android:textSize="11sp"
                    android:textColor="@color/primaryAccent"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_profile_gender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gender: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_profile_tshirt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="T-Shirt Size: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CONTACT & EMERGENCY CONTACT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTACT &amp; EMERGENCY"
                    android:textSize="11sp"
                    android:textColor="@color/primaryAccent"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_profile_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Phone Number: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_profile_emergency_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Emergency Contact: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_profile_emergency_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Emergency Phone: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- EDUCATION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EDUCATION"
                    android:textSize="11sp"
                    android:textColor="@color/primaryAccent"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_profile_education"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No education info"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:padding="16dp"
                        android:lineSpacingExtra="4dp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- DIETARY PREFERENCES -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIETARY PREFERENCES"
                    android:textSize="11sp"
                    android:textColor="@color/primaryAccent"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_profile_dietary_preference"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dietary Preference: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_profile_allergies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Allergies: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BIO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIO"
                    android:textSize="11sp"
                    android:textColor="@color/primaryAccent"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_profile_bio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No bio added yet"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PORTFOLIO & LINKS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PORTFOLIO &amp; LINKS"
                    android:textSize="11sp"
                    android:textColor="@color/primaryAccent"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_profile_github"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GitHub: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/tv_profile_linkedin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="LinkedIn: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/tv_profile_resume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Resume: —"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/tv_profile_skills"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Skills: —"
                            android:textSize="14sp"
                            android:textColor="@color/accentSecondary"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/textSecondary"
        app:itemTextColor="@color/textSecondary"
        app:menu="@menu/bottom_nav_menu"/>
</LinearLayout>
