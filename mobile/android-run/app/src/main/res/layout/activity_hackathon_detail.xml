<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="24sp"
            android:textColor="@color/primaryAccent"
            android:paddingEnd="12dp"/>

        <TextView
            android:id="@+id/tv_hackathon_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/onPrimary"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- ─── ABOUT ─────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionLabel" android:text="ABOUT"/>
                    <TextView
                        android:id="@+id/tv_hackathon_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/textPrimary"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── KEY DETAILS (dates, fee, team size, tracks) ── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionLabel" android:text="DETAILS"/>

                    <!-- Dates row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="📅 Starts" android:textSize="11sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_start_date" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textColor="@color/textPrimary" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🏁 Ends" android:textSize="11sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_end_date" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textColor="@color/textPrimary" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fee + Team Size row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="💰 Fee" android:textSize="11sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_fee" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textColor="@color/accentSecondary" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="👥 Team Size" android:textSize="11sp" android:textColor="@color/textSecondary"/>
                            <TextView android:id="@+id/tv_team_size" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="14sp"
                                android:textColor="@color/textPrimary" android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tracks -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏷️ Tracks" android:textSize="11sp" android:textColor="@color/textSecondary"/>
                    <TextView android:id="@+id/tv_tracks" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textColor="@color/primaryAccent" android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── PROBLEM STATEMENT ────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_problem"
                style="@style/ProfileCard"
                android:layout_marginBottom="14dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionLabel" android:text="🎯 PROBLEM STATEMENT"/>
                    <TextView android:id="@+id/tv_problem_statement"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/textPrimary"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── PRIZES ────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_prizes"
                style="@style/ProfileCard"
                android:layout_marginBottom="14dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionLabel" android:text="🏆 PRIZES"/>
                    <TextView android:id="@+id/tv_prizes"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/textPrimary"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── SCHEDULE ──────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_schedule"
                style="@style/ProfileCard"
                android:layout_marginBottom="14dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionLabel" android:text="📋 SCHEDULE"/>
                    <TextView android:id="@+id/tv_schedule"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/textPrimary"
                        android:lineSpacingExtra="4dp" android:fontFamily="monospace"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── SPONSORS ──────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sponsors"
                style="@style/ProfileCard"
                android:layout_marginBottom="14dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionLabel" android:text="🤝 SPONSORS"/>
                    <TextView android:id="@+id/tv_sponsors"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/textPrimary"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── YOUR STATUS ───────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionLabel" android:text="YOUR STATUS"/>
                    <TextView android:id="@+id/tv_registration_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Loading…" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="@color/onPrimary"/>
                    <TextView android:id="@+id/tv_action_summary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textSize="13sp"
                        android:textColor="@color/textSecondary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── APPLY FORM ────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layout_apply_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileCard"
                    android:layout_marginBottom="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView style="@style/SectionLabel" android:text="APPLICATION"/>

                        <TextView
                            android:id="@+id/tv_incomplete_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Please complete your profile before applying."
                            android:textSize="13sp"
                            android:textColor="#FFF59E0B"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone"/>

                        <LinearLayout
                            android:id="@+id/layout_inputs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                app:boxBackgroundColor="@color/background">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_github" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:hint="GitHub URL"
                                    android:inputType="textUri" android:textColor="@color/onPrimary"
                                    android:textColorHint="@color/textSecondary"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                app:boxBackgroundColor="@color/background">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_linkedin" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:hint="LinkedIn URL"
                                    android:inputType="textUri" android:textColor="@color/onPrimary"
                                    android:textColorHint="@color/textSecondary"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                app:boxBackgroundColor="@color/background">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_resume" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:hint="Resume URL"
                                    android:inputType="textUri" android:textColor="@color/onPrimary"
                                    android:textColorHint="@color/textSecondary"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                app:boxBackgroundColor="@color/background">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_skills" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:hint="Skills (comma-separated)"
                                    android:textColor="@color/onPrimary"
                                    android:textColorHint="@color/textSecondary"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginBottom="14dp" android:hint="Team Preference"
                                app:boxBackgroundColor="@color/background">
                                <AutoCompleteTextView
                                    android:id="@+id/spinner_team_preference"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:inputType="none" android:textColor="@color/onPrimary"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_apply_hackathon"
                            android:layout_width="match_parent" android:layout_height="52dp"
                            android:text="Apply Now" android:textAllCaps="false"
                            android:backgroundTint="@color/primaryAccent"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ─── APPROVED ACTIONS ──────────────────────── -->
            <LinearLayout
                android:id="@+id/layout_approved_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_team_hub"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="🚀 Open Team Hub" android:textAllCaps="false"
                    android:backgroundTint="@color/primaryAccent"
                    app:cornerRadius="12dp" android:layout_marginBottom="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mentor_support"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="🛟 Request Mentor Support" android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/primaryAccent" app:strokeWidth="1dp"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
